generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(UNASSIGNED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts            Account[]
  aiConversations     AIConversation[]
  aiMessages          AIMessage[]
  applications        Application[]
  company             CompanyProfile?
  emails              Email[]
  candidateInterviews Interview[]        @relation("CandidateInterviews")
  employerInterviews  Interview[]        @relation("EmployerInterviews")
  jobs                Job[]
  invitationsReceived JobInvitation[]    @relation("InvitationRecipient")
  invitationsSent     JobInvitation[]    @relation("InvitationSender")
  jobSeeker           JobSeekerProfile?
  notifications       Notification[]
  payments            Payment[]
  projectComments     PortfolioComment[]
  projectLikes        PortfolioLike[]
  projectRatings      PortfolioRating[]
  profileRatingsGiven ProfileRating[]    @relation("ProfileRatingsGiven")
  savedJobs           SavedJob[]
  sessions            Session[]
  subscriptions       Subscription[]
  supportMessages     SupportMessage[]
  supportTickets      SupportTicket[]
  todos               Todo[]

  interviewParticipants InterviewParticipant[]
  interviewTasks        InterviewTask[]        @relation("TaskAssignee")
  interviewNotes        InterviewNote[]
  interviewEvaluations  InterviewEvaluation[]  @relation("EvaluationAuthor")

  @@index([role])
  @@index([createdAt])
  @@map("user")
}

model JobSeekerProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  headline             String
  location             String
  bio                  String
  currentRole          String?
  yearsOfExperience    Int?
  skills               String[]          @default([])
  linkedin             String?
  github               String?
  x                    String?
  profilePhotoUrl      String?
  profilePhotoPublicId String?
  cvUrl                String?
  cvName               String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  onboardingStatus     OnboardingStatus  @default(PENDING)
  averageRating        Float             @default(0)
  bannerPublicId       String?
  bannerUrl            String?
  isAvailable          Boolean           @default(true)
  isDiscoverable       Boolean           @default(true)
  profileViews         Int               @default(0)
  ratingCount          Int               @default(0)
  visibility           ProfileVisibility @default(PUBLIC)
  portfolio            String?

  applications      Application[]
  galleryImages     JobSeekerGalleryImage[]
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioProjects PortfolioProject[]
  ratings           ProfileRating[]
  savedJobs         SavedJob[]

  @@index([location])
  @@index([currentRole])
  @@index([onboardingStatus])
  @@index([visibility])
  @@index([isDiscoverable])
  @@index([isAvailable])
  @@index([averageRating])
  @@map("job_seeker_profile")
}

model JobSeekerGalleryImage {
  id        String   @id @default(cuid())
  profileId String
  url       String
  publicId  String?
  alt       String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([sortOrder])
  @@map("job_seeker_gallery_image")
}

model CompanyProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  companyName         String
  companyWebsite      String?
  companySize         String?
  companyIndustry     String
  companyDescription  String
  companyLocation     String
  companyAddress      String?
  companyContactEmail String
  companyContactPhone String?
  companyLinkedIn     String?
  companyX            String?
  companyFacebook     String?
  companyLogoUrl      String?
  companyLogoPublicId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  onboardingStatus    OnboardingStatus  @default(PENDING)
  bannerPublicId      String?
  bannerUrl           String?
  isDiscoverable      Boolean           @default(true)
  profileViews        Int               @default(0)
  visibility          ProfileVisibility @default(PUBLIC)

  galleryImages CompanyGalleryImage[]
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]

  @@index([companyName])
  @@index([companyIndustry])
  @@index([companyLocation])
  @@index([onboardingStatus])
  @@index([visibility])
  @@index([isDiscoverable])
  @@map("company_profile")
}

model CompanyGalleryImage {
  id        String   @id @default(cuid())
  companyId String
  url       String
  publicId  String?
  alt       String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sortOrder])
  @@map("company_gallery_image")
}

model PortfolioProject {
  id            String            @id @default(cuid())
  profileId     String
  title         String
  slug          String            @unique
  description   String
  category      String?
  skills        String[]          @default([])
  projectUrl    String?
  githubUrl     String?
  visibility    ProjectVisibility @default(PUBLIC)
  status        ProjectStatus     @default(DRAFT)
  featured      Boolean           @default(false)
  likesCount    Int               @default(0)
  commentsCount Int               @default(0)
  ratingCount   Int               @default(0)
  averageRating Float             @default(0)
  viewsCount    Int               @default(0)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  comments PortfolioComment[]
  images   PortfolioImage[]
  likes    PortfolioLike[]
  profile  JobSeekerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ratings  PortfolioRating[]

  @@index([profileId])
  @@index([status])
  @@index([visibility])
  @@index([category])
  @@index([featured])
  @@index([averageRating])
  @@index([createdAt])
  @@map("portfolio_project")
}

model PortfolioImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  publicId  String?
  alt       String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sortOrder])
  @@map("portfolio_image")
}

model PortfolioLike {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("portfolio_like")
}

model PortfolioComment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  body      String
  isEdited  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("portfolio_comment")
}

model PortfolioRating {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([rating])
  @@map("portfolio_rating")
}

model ProfileRating {
  id        String   @id @default(cuid())
  profileId String
  raterId   String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rater   User             @relation("ProfileRatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([profileId, raterId])
  @@index([profileId])
  @@index([raterId])
  @@index([rating])
  @@map("profile_rating")
}

model Job {
  id              String            @id @default(cuid())
  companyId       String
  postedById      String
  title           String
  description     String
  requirements    String?
  location        String?
  workMode        WorkMode          @default(ONSITE)
  employmentType  EmploymentType
  salaryMin       Decimal?
  salaryMax       Decimal?
  salaryCurrency  String?           @default("NGN")
  skills          String[]          @default([])
  status          JobStatus         @default(DRAFT)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approvalStatus  JobApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  applications Application[]
  interviews   Interview[]
  company      CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy     User            @relation(fields: [postedById], references: [id])
  invitations  JobInvitation[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([postedById])
  @@index([status])
  @@index([approvalStatus])
  @@index([location])
  @@index([workMode])
  @@index([employmentType])
  @@index([createdAt])
  @@map("job")
}

model Application {
  id                 String            @id @default(cuid())
  jobId              String
  applicantId        String
  jobSeekerProfileId String
  status             ApplicationStatus @default(PENDING)
  coverLetter        String?
  cvUrl              String?
  cvName             String?
  appliedAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  applicant        User             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeekerProfile JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id], onDelete: Cascade)
  interviews       Interview[]

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([jobSeekerProfileId])
  @@index([status])
  @@map("application")
}

model SavedJob {
  id                 String   @id @default(cuid())
  jobId              String
  userId             String
  jobSeekerProfileId String
  createdAt          DateTime @default(now())

  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeekerProfile JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@index([jobSeekerProfileId])
  @@map("saved_job")
}

model JobInvitation {
  id          String              @id @default(cuid())
  jobId       String
  senderId    String
  recipientId String
  message     String?
  status      JobInvitationStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipient User @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([jobId, recipientId])
  @@index([jobId])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("job_invitation")
}

/**
 * |--------------------------------------------------------------------------
 * | INTERVIEW DOMAIN
 * |--------------------------------------------------------------------------
 * |
 * | Interview is the central workspace for the hiring-stage experience.
 * |
 * | It supports:
 * | - in-person interviews
 * | - online interviews
 * | - AI interviews
 * | - future facial/video verification
 * | - interview tasks
 * | - interview notes
 * | - evaluations
 * | - scheduling/rescheduling
 * | - meeting providers
 * | - interview lifecycle
 * | - future interview recordings/artifacts
 * |
 */

model Interview {
  id            String  @id @default(cuid())
  jobId         String
  applicationId String?

  employerId  String
  candidateId String

  type    InterviewType    @default(ONLINE)
  status  InterviewStatus  @default(SCHEDULED)
  outcome InterviewOutcome @default(PENDING)

  title       String?
  description String?

  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?

  timezone String? @default("Africa/Lagos")

  meetingProvider InterviewProvider?
  meetingUrl      String?
  meetingId       String?
  meetingPasscode String?

  location String?

  notes String?

  cancellationReason String?
  cancelledAt        DateTime?

  rescheduledFromId String?
  rescheduledFrom   Interview?  @relation("InterviewReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Interview[] @relation("InterviewReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application? @relation(fields: [applicationId], references: [id])
  candidate   User         @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  employer    User         @relation("EmployerInterviews", fields: [employerId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  participants InterviewParticipant[]
  tasks        InterviewTask[]
  notesEntries InterviewNote[]
  evaluations  InterviewEvaluation[]
  sessions     InterviewSession[]
  events       InterviewEvent[]

  @@index([jobId])
  @@index([applicationId])
  @@index([employerId])
  @@index([candidateId])
  @@index([scheduledAt])
  @@index([type])
  @@index([status])
  @@index([outcome])
  @@index([meetingProvider])
  @@index([createdAt])
  @@map("interview")
}

model InterviewParticipant {
  id          String                   @id @default(cuid())
  interviewId String
  userId      String
  role        InterviewParticipantRole
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime                 @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([interviewId])
  @@index([userId])
  @@index([role])
  @@map("interview_participant")
}

model InterviewTask {
  id           String  @id @default(cuid())
  interviewId  String
  assignedToId String?

  title       String
  description String?

  status   InterviewTaskStatus @default(TODO)
  priority TodoPriority        @default(MEDIUM)

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview  Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([interviewId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@map("interview_task")
}

model InterviewNote {
  id          String @id @default(cuid())
  interviewId String
  authorId    String

  body       String
  visibility InterviewNoteVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([authorId])
  @@index([visibility])
  @@index([createdAt])
  @@map("interview_note")
}

model InterviewEvaluation {
  id          String @id @default(cuid())
  interviewId String
  evaluatorId String

  overallScore   Decimal?
  recommendation InterviewRecommendation @default(PENDING)

  strengths  String?
  weaknesses String?
  feedback   String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview                      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator User                           @relation("EvaluationAuthor", fields: [evaluatorId], references: [id], onDelete: Cascade)
  criteria  InterviewEvaluationCriterion[]

  @@index([interviewId])
  @@index([evaluatorId])
  @@index([recommendation])
  @@index([createdAt])
  @@map("interview_evaluation")
}

model InterviewEvaluationCriterion {
  id           String @id @default(cuid())
  evaluationId String

  name     String
  score    Decimal?
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@map("interview_evaluation_criterion")
}

model InterviewSession {
  id          String @id @default(cuid())
  interviewId String

  type   InterviewSessionType
  status InterviewSessionStatus @default(PENDING)

  provider          InterviewProvider?
  externalSessionId String?

  startedAt DateTime?
  endedAt   DateTime?

  recordingUrl  String?
  transcriptUrl String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([type])
  @@index([status])
  @@index([externalSessionId])
  @@map("interview_session")
}

model InterviewEvent {
  id          String @id @default(cuid())
  interviewId String

  type     InterviewEventType
  actorId  String?
  metadata Json?

  createdAt DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
  @@map("interview_event")
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String
  href      String?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notification")
}

model Email {
  id         String      @id @default(cuid())
  userId     String?
  toEmail    String
  subject    String
  body       String
  status     EmailStatus @default(PENDING)
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([toEmail])
  @@index([status])
  @@index([createdAt])
  @@map("email")
}

model SupportTicket {
  id         String                @id @default(cuid())
  userId     String
  subject    String
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(NORMAL)
  category   String?
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  messages SupportMessage[]
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("support_ticket")
}

model SupportMessage {
  id         String               @id @default(cuid())
  ticketId   String
  userId     String?
  senderType SupportMessageSender
  body       String
  createdAt  DateTime             @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("support_message")
}

model AIConversation {
  id        String             @id @default(cuid())
  userId    String
  type      AIConversationType @default(GENERAL)
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([type])
  @@index([updatedAt])
  @@map("ai_conversation")
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  userId         String?
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("ai_message")
}

model Todo {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  status      TodoStatus   @default(TODO)
  priority    TodoPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([dueAt])
  @@map("todo")
}

model SubscriptionPlan {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  type        SubscriptionPlanType
  audience    SubscriptionAudience @default(ALL)
  interval    SubscriptionInterval
  price       Decimal
  currency    String               @default("NGN")
  trialDays   Int                  @default(0)

  maxActiveJobs         Int?
  maxApplicationsPerJob Int?
  maxPortfolioProjects  Int?
  maxGalleryImages      Int?
  maxAIRequests         Int?
  maxJobInvitations     Int?

  featuredProfile   Boolean @default(false)
  featuredJobs      Boolean @default(false)
  advancedAnalytics Boolean @default(false)
  prioritySupport   Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([type])
  @@index([audience])
  @@index([isActive])
  @@map("subscription_plan")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  provider           String?
  providerId         String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments Payment[]
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscription")
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Decimal
  currency       String        @default("NGN")
  provider       String?
  reference      String?       @unique
  status         PaymentStatus @default(PENDING)
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@map("payment")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
